# KiCad sources: LF line endings
*.kicad_pro text eol=lf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf

# Visual outputs (RFC 0021): generated by odw render, folded in GitHub diffs and language statistics; the binary
# ones (PNG, PDF, glTF) in Git LFS, the SVG and text ones in git
**/outputs/** linguist-generated=true
**/outputs/**/*.png filter=lfs diff=lfs merge=lfs -text
**/outputs/**/*.pdf filter=lfs diff=lfs merge=lfs -text
**/outputs/**/*.glb filter=lfs diff=lfs merge=lfs -text
# <<< odapkit sync
