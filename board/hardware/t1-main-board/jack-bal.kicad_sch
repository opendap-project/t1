(rectangle (start 95.25 35.56) (end 217.17 72.39) (stroke (width 0) (type dash)) (fill (type none)) (uuid "132db493-78fc-56a9-8501-25494e43a7f7"))
(text "ESD (BOM v1 line 36)" (exclude_from_sim no) (at 96.52 34.29 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid "a56af282-e469-51bf-8a03-f3c715ed78ce"))
(text_box "Notes\n1. Function: 4.4 mm 5-pole jack (L+, L-, R+, R-, GND; JEITA RC-8141C, BOM v1 line 31);\n   TPD1E10B06 on each leg and the detect line (line 36).\n2. Absent state: passive; left off only with blk.hpa-bal (blk.hp-out-bal). Detect: pin 10 to HP_DET_BAL,\n   pin 9 to ground (switch state UNVERIFIED on the drawing), read by expander P11 with its pull-up on the\n   host side, so the line reads \"absent\" with the jack left off.\n3. Pin-to-pad assignment UNVERIFIED (libs kicad/ note): check against a sample before boards.\n4. Open: RF filter footprints near the jack (PCB-A-19, Q2); the Pentaconn alternate land." (exclude_from_sim no) (at 152.4 140.97 0) (size 129.54 20.32) (margins 1.905 1.905 1.905 1.905) (stroke (width 0) (type default)) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dce3c34b-4945-5357-a578-d0558985f979"))
(text "Interface" (exclude_from_sim no) (at 22.86 168.91 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid "d3778bb9-9aa8-5f4a-9874-d5f6bfebef9d"))
