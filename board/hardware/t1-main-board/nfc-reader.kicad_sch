5) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8e0fd815-f5d2-5f14-aeab-bfe5da518666")) (table_cell "Input" (exclude_from_sim no) (at 60.96 252.73 0) (size 22.86 7.62) (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "207f4371-0ebc-55db-a574-b5bd2ffde3cc")) (table_cell "GPIO2_C0, GPIO2_C6 at 1.8 V; SoC pull-downs: hard power-down, normal boot" (exclude_from_sim no) (at 83.82 252.73 0) (size 57.15 7.62) (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0fc91990-e236-5224-9a35-322c656fb8b4")) (table_cell "NFC_IRQ" (exclude_from_sim no) (at 22.86 260.35 0) (size 38.1 5.08) (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0cfa595f-4310-56d5-bf4c-27ec166f6396")) (table_cell "Output" (exclude_from_sim no) (at 60.96 260.35 0) (size 22.86 5.08) (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0fb6bfcd-b9c1-5110-915a-ed4c073ef2ff")) (table_cell "GPIO0_D5; SoC pull-down: no interrupt unfitted" (exclude_from_sim no) (at 83.82 260.35 0) (size 57.15 5.08) (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "73e2041e-4ea4-50ea-b588-6b0a48322ca5")) (table_cell "NFC_PWR_EN" (exclude_from_sim no) (at 22.86 265.43 0) (size 38.1 7.62) (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "513397c4-1cae-59d5-8141-af2a294dd20e")) (table_cell "Input" (exclude_from_sim no) (at 60.96 265.43 0) (size 22.86 7.62) (margins 0.9525 0.9525 0.9525 0.9525) (span 1 1) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8270e861-6fee-55d5-8893-687c4182eb5f")) (table_cell "Exp