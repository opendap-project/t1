(rectangle (start 172.72 35.56) (end 323.85 118.11) (stroke (width 0) (type dash)) (fill (type none)) (uuid "ad3ae9aa-d24b-5a2e-8ad8-25982bb9c45f"))
(text "eFuse #C, USB-C source, RILM 1.87 kΩ (line 44)" (exclude_from_sim no) (at 173.99 34.29 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid "7d1bc066-9953-5ec7-a4eb-61852d7e1dc3"))
(text_box "Notes\n1. Function: eFuse #D limits the 5.1 V source for both ports together (2.021 / 2.268 / 2.520 A);\n   eFuse #C sources the USB-C VBUS (1.589 / 1.783 / 1.981 A) under USB_SRC_ON (RFC 0015).\n2. Absent state: USB_SRC_ON pulled down: #C off, TPS2121 OV1 released.\n3. #D EN/UVLO on its own input: on with the buck. OVLO to GND: no overvoltage lockout.\n4. ITIMER and DVDT open (fastest response, BOM v1 line 44). IMON through 10 kΩ, keeping the\n   1 nF of the SARADC off the ILM node (< 50 pF, SLVSFC9C p. 35); #D IMON on a test pad." (exclude_from_sim no) (at 275.59 229.87 0) (size 129.54 19.05) (margins 1.905 1.905 1.905 1.905) (stroke (width 0) (type default)) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a451e6f4-13b9-5704-b7ea-cd870700f9c2"))
(text "Interface" (exclude_from_sim no) (at 22.86 248.92 0) (effects (font (size 2.54 2.54)) (justify left bottom)) (uuid "9c4aa264-e6a8-5b91-b79d-a55daca4fc8d"))
